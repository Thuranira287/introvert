{
  "expo": {
    "name": "Introvert Corner",
    "slug": "introvert-corner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07112c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.introvertcorner.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07112c"
      },
      "package": "com.introvertcorner.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "CAMERA_ROLL",
        "MEDIA_LIBRARY",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ]
    ],
    "scheme": "introvertcorner",
    "extra": {
      "eas": {
        "projectId": "introvert-corner-mobile"
      }
    }
  }
}

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Google Sign-In (three separate OAuth client IDs from Google Cloud Console —
# one each for iOS, Android, and Web/Expo-proxy. No client secret needed:
# mobile OAuth clients are "public" clients, verified via PKCE + ID token
# signature instead. See apps/mobile/src/hooks/useGoogleSignIn.ts)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase Configuration (for push notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Analytics
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key

# App Configuration
EXPO_PUBLIC_APP_NAME=Introvert Corner
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_AI_CHAT=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# Stripe publishable key (pk_test_... / pk_live_...). Without it the premium
# screen shows that payments are unavailable and never renders a card field.
# The native Stripe SDK needs a development build; it does not run in Expo Go.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

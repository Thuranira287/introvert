# Backend API base URL (must include the /api/v1 prefix set in apps/api/src/main.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.io server URL (no path — namespaces like /messaging are appended by the client)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Stripe publishable key (pk_test_... / pk_live_...). Without it the premium
# page shows that payments are unavailable and never renders a card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

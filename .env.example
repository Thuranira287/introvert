# ============ CORE ============
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ============ DATABASE ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/introvert_corner

# ============ AUTH ============
# Production requires at least 32 characters for both secrets.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too

# ============ AI ASSISTANT ============
# Set OPENAI_API_KEY to use GPT-4o-mini; leave blank to fall back to Ollama.
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama2:7b-chat

# ============ OAUTH ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Mobile app client IDs (separate OAuth clients registered in Google Cloud
# Console for the iOS bundle ID / Android package name). Only used to verify
# the `aud` claim of ID tokens sent by the mobile app — no client secret
# needed for these since mobile OAuth clients are "public" clients.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ============ MEDIA (optional) ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ EMAIL ============
# Required in production for password-reset emails. Without it, emails are
# skipped and a warning is logged (reset links are only printed outside production).
RESEND_API_KEY=
EMAIL_FROM=Introvert Corner <no-reply@yourdomain.com>
# Base URL of the web app, used to build links inside emails.
FRONTEND_URL=http://localhost:3000

# ============ PAYMENTS (required for premium verification purchases) ============
# Without this, PaymentsService refuses every premium purchase/renewal with
# a clear 503 rather than faking a successful charge — see
# apps/api/src/modules/creator/payments.service.ts for why.
STRIPE_SECRET_KEY=

# ============ SCHEDULED JOBS ============
# Premium expiry (daily) and monthly creator earnings run in-process. Set to
# true on web-facing replicas to run them on a single dedicated worker instead.
DISABLE_CRON=false

# ============ PUSH NOTIFICATIONS (optional — push.service.ts dry-runs if unset) ============
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============ MONITORING (optional) ============
SENTRY_DSN=
